  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "start:mock": "EXPO_PUBLIC_USE_MOCKS=true expo start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "jest",
    "doctor": "expo-doctor",
    "prebuild": "expo prebuild --clean"
