# ─────────────────────────────────────────────────────────────────────────────
# App (public). EXPO_PUBLIC_* values are embedded in the app bundle: NEVER put
# secrets here. Copy to apps/mobile/.env (or set them as EAS environment vars).
# ─────────────────────────────────────────────────────────────────────────────
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# true = demo mode: simulated AI, payments and local-only data (no keys needed).
# Mocks are also forced on automatically when Supabase URL/key are empty.
EXPO_PUBLIC_USE_MOCKS=true
EXPO_PUBLIC_FEATURE_HEALTH=false
EXPO_PUBLIC_TERMS_URL=https://plato.app/terminos
EXPO_PUBLIC_PRIVACY_URL=https://plato.app/privacidad
EXPO_PUBLIC_SUPPORT_EMAIL=soporte@plato.app

# App identity (read by app.config.ts at build time)
APP_NAME=Plato
APP_BUNDLE_ID=com.platoapp.plato
EAS_PROJECT_ID=

# ─────────────────────────────────────────────────────────────────────────────
# Server (Edge Functions secrets — `supabase secrets set --env-file ...`).
# Never in the app, never committed.
# ─────────────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
AI_MODEL_FREE=claude-haiku-4-5-20251001
AI_MODEL_PREMIUM=claude-sonnet-5-5
AI_DAILY_BUDGET_USD=20
AI_ALERT_WEBHOOK_URL=
USDA_FDC_API_KEY=
REVENUECAT_WEBHOOK_SECRET=
SUPABASE_SERVICE_ROLE_KEY=
# true = Edge Functions answer with canned AI responses (no Anthropic calls)
AI_MOCK=false

# ─────────────────────────────────────────────────────────────────────────────
# Build / tooling
# ─────────────────────────────────────────────────────────────────────────────
EXPO_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
# Local Postgres used by `pnpm test:db` (RLS tests)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres
